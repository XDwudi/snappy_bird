/* pages/index/index.wxss - 主界面样式 */

.home-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #4ec0ca 0%, #71c5cf 60%, #ded895 60%, #ded895 100%);
  position: relative;
  overflow: hidden;
}

/* ==================== 装饰云朵 ==================== */
.deco-cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
}

.deco-cloud-1 {
  width: 120rpx;
  height: 60rpx;
  top: 15%;
  left: 10%;
  animation: floatCloud 8s ease-in-out infinite;
}

.deco-cloud-2 {
  width: 80rpx;
  height: 40rpx;
  top: 25%;
  right: 15%;
  animation: floatCloud 6s ease-in-out infinite reverse;
}

.deco-cloud-3 {
  width: 100rpx;
  height: 50rpx;
  top: 8%;
  right: 30%;
  animation: floatCloud 10s ease-in-out infinite;
}

@keyframes floatCloud {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(20rpx); }
}

/* ==================== Logo ==================== */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-bird {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: birdBob 1.5s ease-in-out infinite;
}

@keyframes birdBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.logo-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 4rpx 4rpx 0 #d4a017, 6rpx 6rpx 0 rgba(0,0,0,0.2);
  letter-spacing: 8rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* ==================== 最高分 ==================== */
.best-score {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 40rpx;
  text-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.15);
}

/* ==================== 开始按钮 ==================== */
.start-btn {
  width: 400rpx;
  height: 100rpx;
  background: linear-gradient(180deg, #f7d51d 0%, #f0a020 100%);
  border: 4rpx solid #000;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #5a3a00;
  letter-spacing: 8rpx;
  text-shadow: 1rpx 1rpx 0 rgba(255,255,255,0.4);
  box-shadow: 0 6rpx 0 #b87a10, 0 8rpx 16rpx rgba(0,0,0,0.2);
  transition: all 0.1s;
}

.start-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #b87a10, 0 4rpx 8rpx rgba(0,0,0,0.2);
}

/* ==================== 玩法说明 ==================== */
.how-to-play {
  margin-top: 80rpx;
  padding: 30rpx 50rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.howto-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.howto-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
}

/* ==================== 底部 ==================== */
.footer {
  position: absolute;
  bottom: 30rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}
