/* pages/game/game.wxss - 游戏页面样式 */

.game-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ==================== 游戏中分数 ==================== */
.game-score {
  position: absolute;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 4rpx 4rpx 0 #000, -2rpx -2rpx 0 #000, 2rpx -2rpx 0 #000, -2rpx 2rpx 0 #000;
  z-index: 10;
  pointer-events: none;
}

/* ==================== 准备态提示 ==================== */
.ready-overlay {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: none;
  animation: readyFloat 2s ease-in-out infinite;
}

@keyframes readyFloat {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-20rpx); }
}

.ready-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.ready-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 3rpx 3rpx 0 #000;
}

.ready-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

/* ==================== 游戏结束遮罩 ==================== */
.gameover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.gameover-panel {
  width: 560rpx;
  background: linear-gradient(180deg, #fff 0%, #f0f0f0 100%);
  border: 6rpx solid #000;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  animation: panelPop 0.3s ease-out;
}

@keyframes panelPop {
  0% { transform: scale(0.7); opacity: 0; }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.gameover-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.new-record {
  font-size: 36rpx;
  color: #f0a020;
  font-weight: bold;
  margin-bottom: 20rpx;
  animation: recordPulse 0.8s ease-in-out infinite;
}

@keyframes recordPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.score-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.score-label {
  font-size: 32rpx;
  color: #666;
}

.score-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.score-value.best {
  color: #f0a020;
}

.gameover-buttons {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gameover-btn {
  width: 100%;
  height: 88rpx;
  border: 4rpx solid #000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
  transition: all 0.1s;
}

.gameover-btn:active {
  transform: translateY(3rpx);
}

.btn-primary {
  background: linear-gradient(180deg, #f7d51d 0%, #f0a020 100%);
  color: #5a3a00;
  box-shadow: 0 5rpx 0 #b87a10;
}

.btn-primary:active {
  box-shadow: 0 2rpx 0 #b87a10;
}

.btn-secondary {
  background: linear-gradient(180deg, #fff 0%, #e0e0e0 100%);
  color: #333;
  box-shadow: 0 5rpx 0 #999;
}

.btn-secondary:active {
  box-shadow: 0 2rpx 0 #999;
}
