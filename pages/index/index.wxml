<!-- pages/index/index.wxml - 主界面 -->
<view class="home-container">
  <!-- 装饰背景云朵 -->
  <view class="deco-cloud deco-cloud-1"></view>
  <view class="deco-cloud deco-cloud-2"></view>
  <view class="deco-cloud deco-cloud-3"></view>

  <!-- Logo 区域 -->
  <view class="logo-area">
    <view class="logo-bird">🐦</view>
    <view class="logo-title">SNAPPY BIRD</view>
    <view class="logo-subtitle">Roguelike 飞行冒险</view>
  </view>

  <!-- 最高分 -->
  <view class="best-score" wx:if="{{bestScore > 0}}">
    🏆 最高分: {{bestScore}}
  </view>

  <!-- 开始按钮 -->
  <view class="start-btn" bindtap="onStart">
    开 始 游 戏
  </view>

  <!-- 玩法说明 -->
  <view class="how-to-play">
    <view class="howto-title">玩法说明</view>
    <view class="howto-item">👆 点击屏幕让小鸟飞起</view>
    <view class="howto-item">🚧 躲避管道，努力生存</view>
    <view class="howto-item">✨ 收集经验，升级获得能力</view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">v{{version}} · MVP</view>
</view>
