/* pages/game/game.wxss - 游戏页面样式 */

.game-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ==================== 游戏中分数 ==================== */
.game-score {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 4rpx 4rpx 0 #000, -2rpx -2rpx 0 #000, 2rpx -2rpx 0 #000, -2rpx 2rpx 0 #000;
  z-index: 10;
  pointer-events: none;
}

/* ==================== 准备态提示 ==================== */
.ready-overlay {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: none;
  animation: readyFloat 2s ease-in-out infinite;
}

@keyframes readyFloat {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-20rpx); }
}

.ready-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.ready-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 3rpx 3rpx 0 #000;
}

.ready-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

/* ==================== 升级选择面板 ==================== */
.upgrade-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.upgrade-panel {
  width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: panelSlideUp 0.3s ease-out;
}

@keyframes panelSlideUp {
  0% { transform: translateY(400rpx); opacity: 0; }
  60% { transform: translateY(-20rpx); }
  100% { transform: translateY(0); opacity: 1; }
}

.upgrade-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.upgrade-arrow {
  font-size: 48rpx;
  animation: arrowBounce 0.8s ease-in-out infinite;
}

@keyframes arrowBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.upgrade-level {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
  text-shadow: 3rpx 3rpx 0 #000;
}

.upgrade-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 30rpx;
}

.upgrade-cards {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

/* 能力卡牌 */
.ability-card {
  flex-shrink: 0;
  width: 200rpx;
  background: linear-gradient(180deg, #fff 0%, #f0f0f0 100%);
  border: 5rpx solid #000;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  transition: all 0.15s;
  animation: cardPop 0.4s ease-out backwards;
}

.ability-card:nth-child(1) { animation-delay: 0.05s; }
.ability-card:nth-child(2) { animation-delay: 0.15s; }
.ability-card:nth-child(3) { animation-delay: 0.25s; }
.ability-card:nth-child(4) { animation-delay: 0.35s; }

@keyframes cardPop {
  0% { transform: scale(0.5) translateY(100rpx); opacity: 0; }
  60% { transform: scale(1.08) translateY(-10rpx); }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

.ability-card:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

/* 分类边框色 */
.ability-card.passive {
  border-color: #4a90d9;
}

.ability-card.active {
  border-color: #d94a4a;
}

.ability-card.special {
  border-color: #9b59b6;
}

.card-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.card-level {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.card-level-from {
  font-size: 22rpx;
  color: #999;
}

.card-level-arrow {
  font-size: 22rpx;
  color: #666;
}

.card-level-to {
  font-size: 26rpx;
  font-weight: bold;
  color: #d97706;
}

.card-desc {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  margin-bottom: 4rpx;
}

.card-effect {
  font-size: 20rpx;
  color: #888;
  text-align: center;
  margin-bottom: 8rpx;
}

.card-category {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
}

.passive-tag {
  background: #4a90d9;
}

.active-tag {
  background: #d94a4a;
}

.special-tag {
  background: #9b59b6;
}

/* ==================== 游戏结束遮罩 ==================== */
.gameover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.gameover-panel {
  width: 580rpx;
  background: linear-gradient(180deg, #fff 0%, #f0f0f0 100%);
  border: 6rpx solid #000;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  animation: panelPop 0.3s ease-out;
}

@keyframes panelPop {
  0% { transform: scale(0.7); opacity: 0; }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.gameover-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.new-record {
  font-size: 36rpx;
  color: #f0a020;
  font-weight: bold;
  margin-bottom: 20rpx;
  animation: recordPulse 0.8s ease-in-out infinite;
}

@keyframes recordPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.score-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.score-label {
  font-size: 32rpx;
  color: #666;
}

.score-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.score-value.best {
  color: #f0a020;
}

/* 已获得能力 */
.owned-abilities {
  width: 100%;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.owned-abilities-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
  text-align: center;
}

.owned-abilities-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.owned-ability-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #f5f5f5;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

.owned-ability-icon {
  font-size: 24rpx;
}

.owned-ability-name {
  font-size: 22rpx;
  color: #555;
}

.owned-ability-lv {
  font-size: 20rpx;
  color: #d97706;
  font-weight: bold;
}

.gameover-buttons {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gameover-btn {
  width: 100%;
  height: 88rpx;
  border: 4rpx solid #000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
  transition: all 0.1s;
}

.gameover-btn:active {
  transform: translateY(3rpx);
}

.btn-primary {
  background: linear-gradient(180deg, #f7d51d 0%, #f0a020 100%);
  color: #5a3a00;
  box-shadow: 0 5rpx 0 #b87a10;
}

.btn-primary:active {
  box-shadow: 0 2rpx 0 #b87a10;
}

.btn-secondary {
  background: linear-gradient(180deg, #fff 0%, #e0e0e0 100%);
  color: #333;
  box-shadow: 0 5rpx 0 #999;
}

.btn-secondary:active {
  box-shadow: 0 2rpx 0 #999;
}
